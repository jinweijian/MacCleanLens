{
  "name": "mac-clean-lens",
  "version": "0.1.2",
  "description": "A lightweight visual macOS cleanup scanner installed with npm.",
  "type": "module",
  "bin": {
    "mac-clean-lens": "bin/mac-clean-lens.mjs",
    "mac-clean-lens-install": "scripts/install-macos-app.mjs",
    "mac-clean-lens-update": "scripts/update-macos-app.mjs"
  },
  "files": [
    "bin/",
    "scripts/",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node ./bin/mac-clean-lens.mjs",
    "scan": "node ./bin/mac-clean-lens.mjs scan --json",
    "build:mac": "node ./scripts/build-macos-app.mjs",
    "install:mac": "node ./scripts/install-macos-app.mjs",
    "test": "node --test"
  },
  "keywords": [
    "macos",
    "cleanup",
    "disk",
    "scanner"
  ],
  "author": "jinweijian <jinweijian@edusoho.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/jinweijian/MacCleanLens.git"
  },
  "bugs": {
    "url": "https://github.com/jinweijian/MacCleanLens/issues"
  },
  "homepage": "https://github.com/jinweijian/MacCleanLens#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=16.17"
  }
}
